{
  "manifest_version": 3,
  "name": "Clear Eyes — AI feed filter for X",
  "version": "0.1.0",
  "description": "Runs every tweet through Claude before it renders. Keeps intellectual value, hides slop, rage bait, and drama. Bring your own Anthropic API key.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clear Eyes"
  }
}
